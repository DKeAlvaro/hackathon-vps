#!/usr/bin/env bash
# Central repo guard: refs/heads/main cannot be force-pushed (non-fast-forward) or deleted.
# Other branches are free. Installed by server/bootstrap.sh into /srv/hack/project.git/hooks/.
zero=0000000000000000000000000000000000000000
rc=0
while read -r old new ref; do
  [ "$ref" = "refs/heads/main" ] || continue
  if [ "$new" = "$zero" ]; then
    echo "main cannot be deleted." >&2
    rc=1
  elif [ "$old" != "$zero" ] && ! git merge-base --is-ancestor "$old" "$new" 2>/dev/null; then
    echo "main cannot be force-pushed. Run: git pull --rebase, then push again." >&2
    rc=1
  fi
done
exit $rc
